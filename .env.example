# -----------------------------------------------------------------------------
# BitBin environment variables
# Copy this file to `.env` and replace every YOUR_... placeholder.
# See docs/local-development/configuration.md for where to get each value.
# -----------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL connection string (Neon or any Postgres 15+)
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST/YOUR_DB_NAME?sslmode=require"

# NextAuth (generate a secret with `npx auth secret`)
AUTH_URL="http://localhost:3000"
AUTH_SECRET="YOUR_AUTH_SECRET"

# GitHub OAuth app
AUTH_GITHUB_ID="YOUR_GITHUB_CLIENT_ID"
AUTH_GITHUB_SECRET="YOUR_GITHUB_CLIENT_SECRET"

# Resend (transactional email)
RESEND_API_KEY="YOUR_RESEND_API_KEY"
# Optional: defaults to Resend's shared sandbox sender, which only delivers
# to the email address your Resend account was created with. Set this to an
# address on a domain you've verified in Resend to email any recipient.
# FROM_EMAIL="BitBin <noreply@yourdomain.com>"

# Set to "true" to skip email verification during local development
SKIP_EMAIL_VERIFICATION="true"

# Upstash Redis (rate limiting). Leave empty to disable rate limiting locally.
UPSTASH_REDIS_REST_URL="YOUR_UPSTASH_REDIS_REST_URL"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REDIS_REST_TOKEN"

# Cloudflare R2 (file & image uploads)
R2_ACCOUNT_ID="YOUR_R2_ACCOUNT_ID"
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="YOUR_R2_BUCKET_NAME"
# The bucket stays private. This is only the name stored file URLs are built from; set it once and never change it.
R2_PUBLIC_URL="https://YOUR_BUCKET_PUBLIC_URL.r2.dev"

# Stripe (Pro subscriptions)
STRIPE_SECRET_KEY="YOUR_STRIPE_SECRET_KEY"
STRIPE_PUBLISHABLE_KEY="YOUR_STRIPE_PUBLISHABLE_KEY"
STRIPE_WEBHOOK_SECRET="YOUR_STRIPE_WEBHOOK_SECRET"
STRIPE_PRICE_ID_MONTHLY="YOUR_STRIPE_MONTHLY_PRICE_ID"
STRIPE_PRICE_ID_YEARLY="YOUR_STRIPE_YEARLY_PRICE_ID"

# Production only: the secret Vercel's daily cron sends to /api/cron/reset-demo, which resets the public
# demo account. Without it that route refuses to run. Generate one with: openssl rand -hex 32
# CRON_SECRET=""

# AI features for Pro users (OpenAI or any OpenAI-compatible provider)
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"
# Optional. For OpenRouter use:
#   OPENAI_BASE_URL="https://openrouter.ai/api/v1"
#   AI_MODEL="openai/gpt-5-nano"
# OPENAI_BASE_URL=""
# AI_MODEL="gpt-5-nano"

# Scripts that delete or overwrite data (db:seed, db:cleanup) refuse to run on a database that is not listed here.
# List only development databases, comma separated. For any other database, confirm once with
# CONFIRM_DATABASE_HOST=<host> on the command line.
# SAFE_DATABASE_HOSTS=""

# Error monitoring (Sentry). Production only; unset, nothing is sent.
# SENTRY_DSN=""
