{
  "name": "bitbin-desktop",
  "productName": "BitBin",
  "version": "0.1.0",
  "private": true,
  "description": "Save the clipboard to BitBin from the system tray. Requires BitBin Pro.",
  "author": "Divyanshu Agrahari",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"src/**/*.test.js\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.divyanshuagrahari.bitbin",
    "productName": "BitBin",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "!src/**/*.test.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Development"
    }
  }
}
